\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Two dead ends (measured).} Linear-probe $R^2$ for block pose and agent position, from the $\tau $-slow vs.\ $\tau $-fast half of each spectrum. LeWM (compressed, PR $= 6.2$) cannot be split because any half spans the whole physical state; E$^2$-JEPA (overcomplete, PR $= 114.5$) has room but the halves are interchangeable because per-dimension $\tau $ is homogenized. Information is present in both; temporal organization is present in neither.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:deadends}{{3}{5}{\textbf {Two dead ends (measured).} Linear-probe $R^2$ for block pose and agent position, from the $\tau $-slow vs.\ $\tau $-fast half of each spectrum. LeWM (compressed, PR $= 6.2$) cannot be split because any half spans the whole physical state; E$^2$-JEPA (overcomplete, PR $= 114.5$) has room but the halves are interchangeable because per-dimension $\tau $ is homogenized. Information is present in both; temporal organization is present in neither}{figure.3}{}}
